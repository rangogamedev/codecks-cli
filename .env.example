# codecks-cli configuration
# Recommended: run `py codecks_api.py setup` for interactive setup instead
# of editing this file manually.
#
# Manual setup: copy this file to .env and fill in your values:
#   cp .env.example .env

# Your Codecks account subdomain (e.g. "myteam" for myteam.codecks.io)
CODECKS_ACCOUNT=your-account-name

# Codecks API token (cdxut_... or cdxat_...): Your Profile > API Tokens
# Lasts until revoked (or its optional expiry date). Old browser `at` cookies no longer work (Codecks v2.96).
CODECKS_TOKEN=cdxut_your-api-token

# Deck that new cards go to when you don't pass --deck.
# Change it any time with: codecks-cli default-deck <deck name>  (stores the deck ID;
# a hand-written deck name like the one below also works)
CODECKS_DEFAULT_DECK=Inbox

# Project name mapping (API can't query project names, so store them here)
# Format: uuid1=Project Name,uuid2=Other Project
# Find UUIDs by running: py codecks_api.py decks
CODECKS_PROJECTS=

# Milestone name mapping (same reason)
# Format: uuid1=Milestone Name,uuid2=Other Milestone
CODECKS_MILESTONES=

# Your user ID (auto-discovered by setup, needed for hand commands)
CODECKS_USER_ID=

# HTTP transport tuning (optional)
# CODECKS_HTTP_TIMEOUT_SECONDS=30
# CODECKS_HTTP_MAX_RETRIES=2
# CODECKS_HTTP_RETRY_BASE_SECONDS=1.0
# CODECKS_HTTP_MAX_RESPONSE_BYTES=5000000
# CODECKS_HTTP_LOG=false
# CODECKS_HTTP_LOG_SAMPLE_RATE=1.0

# Game Design Document (optional) — used by gdd and gdd-sync commands
# GDD_GOOGLE_DOC_URL=https://docs.google.com/document/d/your-doc-id/edit

# Google OAuth2 (optional, for private Google Docs access)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a project (free) > Enable "Google Drive API"
# 3. Create OAuth 2.0 Client ID (Desktop app type)
# 4. Copy the Client ID and Client Secret here
# 5. Run: py codecks_api.py gdd-auth
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# MCP HTTP server (Docker and run_mcp_http.py)
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8808
